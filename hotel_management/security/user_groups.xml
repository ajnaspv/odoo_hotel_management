<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="module_category_hotel_management" model="ir.module.category">
        <field name="name">Hotel Management</field>
        <field name="description">Helps you manage Hotel Management access rights</field>
        <field name="sequence">25</field>
    </record>
    <record id="hotel_management_privilege" model="res.groups.privilege">
        <field name="name">Hotel Management</field>
        <field name="category_id" ref="module_category_hotel_management"/>
    </record>
    <record id="group_hotel_management_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="privilege_id" ref="hotel_management_privilege"/>
        <field name="implied_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/>
        <field name="comment">create Accommodations, Food Orders, and Invoices access to hotel_management Module.</field>

    </record>
    <record id="group_hotel_management_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="hotel_management_privilege"/>
        <field name="implied_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/>
        <field name="comment">Full access to hotel_management Module, including configuration.</field>
    </record>
</odoo>
