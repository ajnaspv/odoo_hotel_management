<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hotel_payments_view" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">hotel.payments</field>
        <field name="arch" type="xml">
            <list string="Food Orders">
                <field name="description"/>
                <field name="uom"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="subtotal"/>
            </list>
        </field>
    </record>
</odoo>