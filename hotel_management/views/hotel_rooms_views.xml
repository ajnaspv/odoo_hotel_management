<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hotel_rooms_action" model="ir.actions.act_window">
        <field name="name">Hotel Rooms</field>
        <field name="res_model">hotel.rooms</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--List view-->

    <record id="hotel_rooms_list_view" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">hotel.rooms</field>
        <field name="arch" type="xml">
            <list string="Hotels">
                <field name="room_number"/>
                <field name="bed_type"/>
                <field name="rent"/>
                <field name="facilities_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!--    Form View-->
    <record id="hotel_rooms_form_view" model="ir.ui.view">
        <field name="name">Form View</field>
        <field name="model">hotel.rooms</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable':'1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="room_number"/>
                            <field name="bed_type"/>
                            <field name="available_beds" invisible="bed_type != 'dormitory'"/>

                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="rent" />
                            <field name="facilities_id" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>