<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hotel_food_order_lines_list_view" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">hotel.food.order.lines</field>
        <field name="arch" type="xml">
            <list string="Food Orders">
                <field name="order_room_id"/>
                <field name="food_order_reference"/>
                <field name="food_item_id"/>
                <field name="food_qty"/>
                <field name="price"/>
                <field name="subtotal"/>
            </list>
        </field>
    </record>
</odoo>