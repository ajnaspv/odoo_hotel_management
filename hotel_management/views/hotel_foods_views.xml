<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hotel_foods_action" model="ir.actions.act_window">
        <field name="name">Hotel Foods</field>
        <field name="res_model">hotel.foods</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--List view-->

    <record id="hotel_foods_list_view" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">hotel.foods</field>
        <field name="arch" type="xml">
            <list string="Foods" >
                <field name="name"/>
                <field name="category_id"/>
                <field name="description"/>
                <field name="image" widget="image" options="{'size': [128, 128]}"/>
                <field name="price"/>
                <field name="available_qty"/>
            </list>
        </field>
    </record>

    <!--    Form View-->
    <record id="hotel_foods_form_view" model="ir.ui.view">
        <field name="name">Form View</field>
        <field name="model">hotel.foods</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="description"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price"/>
                        </group>
                        <group>
                            <field name="image" widget="image" options="{'size': [128, 128]}" nolabel="1" class="oe_avatar"/>
                        </group>
                        <group>
                            <field name="available_qty"/>

                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>