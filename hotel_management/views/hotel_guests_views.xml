<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--List view-->
    <record id="hotel_guests_list_view" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">hotel.guests</field>
        <field name="arch" type="xml">
            <list string="Guests" editable="bottom">
                <field name="partner_id"/>
                <field name="age"/>
                <field name="gender"/>
            </list>
        </field>
    </record>
</odoo>