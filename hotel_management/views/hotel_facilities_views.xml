<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hotel_facilities_action" model="ir.actions.act_window">
        <field name="name">Hotel Facilities</field>
        <field name="res_model">hotel.facilities</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--List view-->

    <record id="hotel_facilities_list_view" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">hotel.facilities</field>
        <field name="arch" type="xml">
            <list string="Facilities">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!--    Form View-->
    <record id="hotel_facilities_form_view" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">hotel.facilities</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>