<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hotel_food_orders_action" model="ir.actions.act_window">
        <field name="name">Order Food</field>
        <field name="res_model">hotel.food.orders</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <!--List view-->

    <record id="hotel_foods__orders_list_view" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">hotel.food.orders</field>
        <field name="arch" type="xml">
            <list string="Foods">
                <field name="room_id"/>
                <field name="guest_name"/>
                <field name="order_date"/>
            </list>
        </field>
    </record>

    <!--    Form View-->
    <record id="hotel_foods__orders_form_view" model="ir.ui.view">
        <field name="name">Form View</field>
        <field name="model">hotel.food.orders</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="room_id"/>
                            <field name="guest_name"/>
                            <field name="order_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Menu">
                            <group>
                                <field name="category_ids" widget="many2many_tags"
                                       placeholder="Select food categories"/>
                            </group>
                            <field name="food_ids" mode="kanban" context="{'default_order_id': id}">
                                <kanban>
                                    <templates>
                                        <t t-name="card" class="row">
                                            <field name="category_id"/>
                                            <field name="image" widget="image" options="{'size': [60, 60]}"/>
                                            <field name="name" class="fw-bolder"/>
                                            <field name="price" class="text-muted"/>
                                        </t>
                                    </templates>
                                </kanban>

                                <form>
                                    <sheet>
                                        <group>
                                            <field name="image" widget="image" options="{'size': [120, 120]}"/>
                                            <field name="name" class="fw-bolder"/>
                                            <field name="price"/>
                                            <field name="order_qty"/>
                                        </group>
                                    </sheet>
                                    <footer>
                                        <button name="action_qty_entry" type="object"
                                                string="Add to List"
                                                class="btn-primary"/>
                                    </footer>
                                </form>
                            </field>
                        </page>
                        <page string="Order Lines">
                            <field name="order_line_ids">
                                <list editable="bottom">
                                    <field name="food_item_id"/>
                                    <field name="food_category_ids" widget="many2many_tags"/>
                                    <field name="food_qty"/>
                                    <field name="price"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>