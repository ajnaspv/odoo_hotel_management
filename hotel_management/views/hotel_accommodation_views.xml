<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hotel_accommodation_action" model="ir.actions.act_window">
        <field name="name">Hotel Accommodation</field>
        <field name="res_model">hotel.accommodation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--List view-->

    <record id="hotel_accommodation_list_view" model="ir.ui.view" >
        <field name="name">List View</field>
        <field name="model">hotel.accommodation</field>
        <field name="arch" type="xml">
            <list string="Accommodation">
                <field name="guest_id"/>
                <field name="number_of_guests"/>
                <field name="additional_guest_ids"/>
                <field name="check_in_date"/>
                <field name="check_out_date"/>
                <field name="bed_type"/>
                <field name="facility_ids"/>
                <field name="room_ids"/>
                <field name="state"/>
                <field name="id_proof"/>
            </list>
        </field>
    </record>

    <!--    Form View-->
    <record id="hotel_accommodation_form_view" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">hotel.accommodation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="check_in_action" type="object" invisible="state != 'draft'" string="Check In"/>
                    <button name="check_out_action" type="object" invisible="state != 'check_in'" string="Check Out"/>
                    <field name="state" widget="statusbar" options="{'clickable':True}"/>
                </header>
                <sheet>
                    <h1>
                        <field name="booking_reference" placeholder="Booking reference"/>
                    </h1>
                    <group>
                        <group>
                            <field name="guest_id" context="{'show_address':1}"/>
                            <field name="bed_type"/>
                            <field name="facility_ids" options="{'no_create': True}" widget="many2many_tags"/>
                            <field name="room_ids" options="{'no_create': True}" widget="many2many_tags"/>
                            <field name="id_proof"/>
                        </group>
                        <group>
                            <field name="number_of_guests"/>
                            <!--                            <field name="additional_guest_ids" invisible="number_of_guests &lt;= 1" widget="many2many_tags"/>-->
                            <field name="check_in_date" readonly="state != 'draft'"/>
                            <field name="check_out_date"/>
                            <field name="expected_days" invisible="state not in ['draft','check_in']"/>
                            <field name="expected_date" invisible="state not in ['draft','check_in']"/>

                        </group>
                    </group>
                    <notebook>
                        <page string="Guest Information" invisible="number_of_guests &lt;= 1">
                            <field name="additional_guest_ids"/>
                        </page>
                    </notebook>
                </sheet>
        <chatter/>
            </form>
        </field>
    </record>
</odoo>