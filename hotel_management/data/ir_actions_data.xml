<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Server Action: Create Food Product template -->
    <record id="action_create_food_product" model="ir.actions.server">
        <field name="name">Create Food Product</field>
        <field name="model_id" ref="model_hotel_foods"/>
        <field name="state">code</field>
        <field name="code">create_food_product()</field>
    </record>
     <!-- Automated Action: Trigger on Food Created -->
    <record id="automated_action_create_food_product" model="base.automation">
        <field name="name">Create Food</field>
        <field name="model_id" ref="model_hotel_foods"/>
        <field name="trigger">on_create</field>
        <field name="action_server_ids" eval="[(4, ref('action_create_food_product'))]"/>
    </record>
</data>
</odoo>