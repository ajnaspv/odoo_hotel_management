<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <record id="email_template_checkout_reminder" model="mail.template">
       <field name="name">Checkout Reminder</field>
       <field name="model_id" ref="model_hotel_accommodation"/>
       <field name="subject">Checkout Reminder</field>
       <field name="email_from">noreply@greenview.hotel</field>
       <field name="email_to">{{object.guest_id.email}}</field>
       <field name="use_default_to" eval="False"/>
       <field name="body_html" type="html">
               <p>Dear <t t-out="object.guest_id.name"/>,</p>
               <p>This is a reminder to your checkout date is today.</p>
               <p><strong>Please make sure you will check out it on time.</strong></p>
               <br/>
               <p>Best regards,<br/>Greenview Hotel</p>
       </field>
   </record>
</odoo>
