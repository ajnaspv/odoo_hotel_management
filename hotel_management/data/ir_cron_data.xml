<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <data noupdate="1">
       <record id="daily_room_rent_update" model="ir.cron">
           <field name="name">Daily Room Rent Update</field>
           <field name="model_id" ref="model_hotel_accommodation"/>
           <field name="state">code</field>
           <field name="code">model.update_room_rent()</field>
           <field name="user_id" ref="base.user_root"/>
           <field name='interval_number'>1</field>
           <field name='interval_type'>days</field>
           <field name="nextcall"
                  eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/>
           <field name="priority">1</field>
       </record>
   </data>
</odoo>
