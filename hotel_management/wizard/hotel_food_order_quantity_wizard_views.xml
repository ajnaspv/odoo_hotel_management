<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hotel_food_order_quantity_form_view" model="ir.ui.view">
        <field name="name">Form View</field>
        <field name="model">hotel.food.order.quantity.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="food_item_name"/>
                        <field name="order_qty"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_qty_entry" type="object"
                            string="Add to List"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>